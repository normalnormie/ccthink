#!/usr/bin/env python3
# ABOUTME: Executable entry point for ccthink
# ABOUTME: Launches the ccthink monitoring application

import sys
from pathlib import Path

# Resolve symlink to get actual installation directory
script_path = Path(__file__).resolve()
install_dir = script_path.parent

# Add src to path
sys.path.insert(0, str(install_dir / "src"))

from main import main

if __name__ == "__main__":
    main()
